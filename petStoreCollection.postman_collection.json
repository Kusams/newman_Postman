						"pet",
						"{{petId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "deletePet",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"verify pet with id was deleted from the list: \" + pm.info.requestName, function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonBody = pm.response.json();",
							"    pm.expect(jsonBody.code).to.eql(200);",
							"    pm.expect(jsonBody.type).to.eql(\"unknown\");",
							"    pm.expect(parseInt(jsonBody.message)).to.eql(pm.variables.get(\"petId\"));",
							"});",
							"setTimeout(function(){}, 3000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "authority",
						"value": "petstore.swagger.io",
						"disabled": true
					},
					{
						"key": "accept",
						"value": "*/*",
						"disabled": true
					},
