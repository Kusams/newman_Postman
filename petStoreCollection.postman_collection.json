	"item": [
		{
			"name": "getPetAvailability",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"find the pet Id: \" + pm.info.requestName, function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonBody = pm.response.json();",
							"    for (var i in jsonBody) {",
							"        if(jsonBody[i].name !==\"fish\"){",
							"            console.log('values is '+i);",
							"           pm.environment.set(\"petNameBeforeUpdate\", jsonBody[i].name);",
							"           pm.environment.set(\"petId\", jsonBody[i].id); ",
							"           console.log('petId is '+jsonBody[i].id);",
							"           console.log('pet name is '+jsonBody[i].name);",
							"            break;",
							"        }",
							"    }  ",
							"});",
							"setTimeout(function(){}, 5000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "authority",
						"value": "petstore.swagger.io"
					},
					{
						"key": "accept",
						"value": "*/*"
					}
				],
				"url": {
					"raw": "https://petstore.swagger.io/v2/pet/findByStatus?status=available",
					"protocol": "https",
					"host": [
						"petstore",
						"swagger",
						"io"
					],
					"path": [
						"v2",
						"pet",
						"findByStatus"
					],
					"query": [
						{
							"key": "status",
							"value": "available"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "updatePetName",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"update the pet name: \" + pm.info.requestName, function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonBody = pm.response.json();",
							"    if(jsonBody.name=='donkeyssss'){",
							"        pm.environment.set(\"petNameAfterUpdate\", jsonBody.name);",
							"    }",
							"    ",
							"});",
							"setTimeout(function(){}, 3000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "authority",
						"value": "petstore.swagger.io"
					},
					{
						"key": "accept",
						"value": "*/*"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n        \"id\": {{petId}},\n        \"category\": {\n            \"id\": 0,\n            \"name\": \"string\"\n        },\n        \"name\": \"donkeyssss\",\n        \"photoUrls\": [\n            \"string\"\n        ],\n        \"tags\": [\n            {\n                \"id\": 0,\n                \"name\": \"string\"\n            }\n        ],\n        \"status\": \"available\"\n    }",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://petstore.swagger.io/v2/pet/",
					"protocol": "https",
					"host": [
						"petstore",
						"swagger",
						"io"
					],
					"path": [
						"v2",
						"pet",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "getPedName_afterRenameing",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"find and verify the the pet name after update: \" + pm.info.requestName, function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonBody = pm.response.json();",
							"    pm.expect(jsonBody.name).to.not.eql(pm.variables.get(\"petNameBeforeUpdate\"));",
							"});",
							"setTimeout(function(){}, 3000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "authority",
						"value": "petstore.swagger.io"
					},
					{
						"key": "accept",
						"value": "*/*"
					}
				],
				"url": {
					"raw": "https://petstore.swagger.io/v2/pet/{{petId}}",
					"protocol": "https",
					"host": [
						"petstore",
